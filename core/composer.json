{
    "name": "neuronbook/trip-planner",
    "description": "Plan and book a trip anywhere in the world: an agentic NeuronAI v4 workflow with a human in the loop.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ai", "agents", "neuron-ai", "workflow", "human-in-the-loop", "php"],
    "authors": [
        {
            "name": "Hidran Arias"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "neuron-core/neuron-ai": "^4.0.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "NeuronBook\\TripPlanner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeuronBook\\TripPlanner\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": ["@lint", "@stan", "@test"],
        "lint": "find src run tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null && echo 'php -l: all files parse'",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
