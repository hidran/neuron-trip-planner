# The language model. Any Neuron provider works; Ollama is free and local.
NEURON_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Real flights and hotels (optional). Free keys: https://developers.amadeus.com
# Without them the planner uses the sandbox inventory from core/.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (default) or "production"
AMADEUS_ENV=test

# Open web search for the advisor (optional). https://tavily.com
TAVILY_API_KEY=

# 1 = print every online API request, with status and timing, to the terminal.
TRIP_TRACE=1
# Seconds a GET answer is remembered on disk (default 21600 = 6 hours).
TRIP_CACHE_TTL=21600
