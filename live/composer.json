{
    "name": "neuronbook/trip-planner-live",
    "description": "The trip planner, with real online APIs as agent tools: weather forecasts, holidays, currency rates, travel advisories, destination guides, points of interest and (optionally) Amadeus flights and hotels.",
    "type": "project",
    "license": "MIT",
    "keywords": ["ai", "agents", "neuron-ai", "tools", "api", "php"],
    "authors": [
        {
            "name": "Hidran Arias"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "neuron-core/neuron-ai": "^4.0.3",
        "neuronbook/trip-planner": "*@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "repositories": [
        {
            "name": "trip-planner-core",
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "NeuronBook\\TripPlannerLive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeuronBook\\TripPlannerLive\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "record": "php bin/record-fixtures.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
